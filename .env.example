# =============================================================================
# LitPortal Backend — Environment Variables (example / template)
# =============================================================================
# Copy this file to `.env` and fill in real values. The backend loads this via
# python-dotenv at import time: `load_dotenv(ROOT_DIR / ".env")` in
# core/config.py and server.py (ROOT_DIR == this directory).
#
# Origin: extracted from "LitPortal-On-Emergent-05.26.26" (Emergent-built
# "ClinEvidence Search API", FastAPI + MongoDB/Motor). The platform never
# committed a .env / .env.example — all values were injected via the Emergent
# Deploy env UI. This file reconstructs the full surface (~90 vars) from the
# source plus the new Scienthesis integration variables.
#
# Legend:
#   [REQUIRED]      app will not start / not function without it
#   [REQUIRED-PROD] safe to omit in local dev, MUST be set in production
#   (default: X)    value used by the code when the var is unset
#
# IMPORTANT NAMING FOOT-GUNS (both names are live in different code paths):
#   - OpenAlex polite-pool: the connector reads OPENALEX_MAILTO; Settings also
#     declares OPENALEX_EMAIL (NOT read by the connector). Set OPENALEX_MAILTO.
#   - Crossref polite-pool: the access broker / r1c read CROSSREF_MAILTO;
#     known_article_lookup reads CROSSREF_EMAIL. Set BOTH to the same address.
#   - NCBI/PubMed key: NCBI_API_KEY and PUBMED_API_KEY are both honored.
# =============================================================================


# -----------------------------------------------------------------------------
# Core / runtime
# -----------------------------------------------------------------------------
# Environment label. IS_PRODUCTION = (APP_ENV == "production"). Drives the
# fail-closed production guards run at startup (see server.py lifespan).
APP_ENV=development

# CORS allowed origins. Comma-separated list. In PRODUCTION do NOT use "*"
# (the server strips a bare "*" because allow_credentials=True is incompatible
# with it) — list explicit origins, e.g.
#   CORS_ORIGINS=https://litportal.scienthesis.ai,http://localhost:3000
CORS_ORIGINS=*

# Bind host/port. NOT read by the app itself — they are consumed by the run
# command (Dockerfile CMD / uvicorn). Kept here so the launcher can read them.
HOST=0.0.0.0
PORT=8000


# -----------------------------------------------------------------------------
# Database (MongoDB / Motor) — REQUIRED
# -----------------------------------------------------------------------------
# core/config.py reads these with os.environ[...] (NO default) -> the process
# raises KeyError at import time if either is missing. A reachable MongoDB is
# required for the startup seeders/index-bootstrap to complete.
MONGO_URL=mongodb://localhost:27017            # [REQUIRED] e.g. mongodb+srv://user:pass@cluster/...
DB_NAME=litportal                              # [REQUIRED] dedicated DB name (avoid "test" in the name outside CI)


# -----------------------------------------------------------------------------
# Native auth / JWT (Portal Engine local tokens)
# -----------------------------------------------------------------------------
# These sign the backend's own OTP/password access+refresh tokens. If left
# unset they are AUTO-GENERATED per process (secrets.token_hex(32)) — fine for
# a single dev process, but it invalidates every token on restart and differs
# per worker/replica. ALWAYS set them explicitly in production.
JWT_ACCESS_SECRET=                             # [REQUIRED-PROD] random 64-char hex
JWT_REFRESH_SECRET=                            # [REQUIRED-PROD] random 64-char hex (different from access)
JWT_ALGORITHM=HS256                            # (default: HS256)
JWT_ACCESS_TTL_MINUTES=60                      # (default: 60)
JWT_REFRESH_TTL_DAYS=7                         # (default: 7)

# Refresh-token cookie (name "ces_refresh_token", path "/api/auth").
COOKIE_SECURE=false                            # set true in production (HTTPS)
COOKIE_SAMESITE=lax                            # lax | strict | none

# In-memory login brute-force limiter (per email+IP; not shared across workers).
LOGIN_RATE_LIMIT_MAX=5                          # (default: 5)
LOGIN_RATE_LIMIT_WINDOW_MIN=15                  # (default: 15)


# -----------------------------------------------------------------------------
# Scienthesis platform integration (NEW) — Identity + LitHub
# -----------------------------------------------------------------------------
# Wires LitPortal into the central Scienthesis services. BOTH master flags
# default OFF, so with this section blank the backend behaves exactly like the
# standalone Emergent backend (native auth + local Mongo library). Flip the
# flags on once the central services are reachable. Rollback = flip off.

# --- Master feature flags (default OFF = no-op) ---
# When true: (1) the /api/auth/* endpoints (signup, login, request-otp,
# verify-otp, refresh, logout) DELEGATE to the central Identity Service, so
# logging in on LitPortal returns an Identity RS256 token that ALSO works on
# LitPulse; and (2) get_current_user accepts Identity RS256 JWTs (verified
# offline via JWKS) and lazy-provisions a local Mongo shadow user keyed by sub.
LITPORTAL_USE_IDENTITY=false
# When true, library saves are mirrored into LitHub (best-effort, background +
# outbox retry) and listings can be enriched/served from LitHub.
LITPORTAL_DUAL_WRITE_LITHUB=false

# --- Identity service (scienthesis-identity, default port 8100) ---
IDENTITY_BASE_URL=http://localhost:8100
# Explicit JWKS endpoint; if blank, falls back to {IDENTITY_BASE_URL}/.well-known/jwks.json
IDENTITY_JWKS_URL=http://localhost:8100/.well-known/jwks.json
IDENTITY_JWT_ISSUER=scienthesis-identity        # must match Identity's JWT_ISSUER
IDENTITY_JWT_AUDIENCE=litportal                 # our app's audience (one of Identity's JWT_AUDIENCES)
JWKS_CACHE_TTL_SECONDS=300                       # (default: 300) in-process JWKS cache TTL

# --- LitHub central library (scienthesis-lithub, default port 8200) ---
LITHUB_BASE_URL=http://localhost:8200

# --- Service-to-service auth (shared HS256 secret) ---
# Signs the X-Service-Token header on internal (/api/v1/internal/*) calls to
# Identity and LitHub. MUST be byte-identical across identity, lithub, litpulse,
# and litportal, and rotated jointly. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SERVICE_TOKEN_SECRET=                            # [REQUIRED to use the integration]

# --- Optional LitPulse legacy bridge (cutover only) ---
# Lets LitPortal ALSO accept HS256 tokens still minted by the LitPulse backend
# during the window before LitPulse fully moves to central Identity, so LitPulse
# users are not interrupted. Once both apps issue Identity tokens, leave OFF.
# The secret must equal LitPulse's own JWT signing secret.
LITPULSE_JWT_ENABLED=false
LITPULSE_JWT_SECRET_KEY=

# --- B10 — LitPulse module mount ---
# When enabled, EVERY LitPortal router is ALSO mounted under the module prefix
# (so LitPortal runs both standalone at /api/* AND as a LitPulse module at
# /api/litportal/*), without changing the existing routes.
LITPORTAL_MODULE_MOUNT_ENABLED=true              # (default: true)
LITPORTAL_MODULE_PREFIX=/api/litportal           # (default: /api/litportal)


# -----------------------------------------------------------------------------
# AI agents (LitPortal 2.5-week scope) — 3 advisory sidecars, all default OFF
# -----------------------------------------------------------------------------
# Governance: these NEVER call sources, select/exclude/reorder deterministic
# results, or generate citations. They require an LLM provider (set LLM_PROVIDER
# + key above). See agents/README.md.

# Agent 1 — pre-parser query categorizer/enricher. Refines a weak deterministic
# question type ("other") so e.g. a drug question is not mis-routed.
AI_QUERY_CATEGORIZER_ENABLED=false
AI_QUERY_CATEGORIZER_MIN_CONFIDENCE=0.75      # only override "other" at/above this confidence

# Agent 2 — question understanding / ContextAugment (B3). Diagnostics only.
AI_CONTEXT_AUGMENT_ENABLED=false
AI_CONTEXT_AUGMENT_PREVIEW_ENABLED=false

# Agent 3 — evidence surfacing + ranker optimization (B4 / B4a). Advisory shelf only.
AI_EVIDENCE_SURFACING_ENABLED=false
AI_EVIDENCE_SURFACING_PREVIEW_VISIBLE=false
AI_EVIDENCE_SURFACING_USER_VISIBLE_ALLOWED=false   # keep OFF unless owner approves
AI_RANKER_OPTIMIZATION_ENABLED=false
AI_RANKER_PARALLEL_SEARCH_ENABLED=false            # parallel supplemental AI search (execution = follow-up)
MAX_AI_SURFACING_CANDIDATES=30
MAX_RANKER_PARALLEL_AI_CANDIDATES=20
MIN_AI_SURFACING_CONFIDENCE=0.65
MIN_RANKER_OPTIMIZATION_CONFIDENCE=0.65


# -----------------------------------------------------------------------------
# LLM / AI providers
# -----------------------------------------------------------------------------
# Provider selector: none | openai | openrouter | anthropic | emergent.
#   "none"      -> LLM disabled (deterministic-only pipeline; summary disabled).
#   "openai"    -> direct OpenAI (RECOMMENDED off-platform). Set OPENAI_API_KEY.
#   "openrouter"-> OpenAI-compatible gateway. Set OPENROUTER_API_KEY (+ MODEL).
#   "emergent"  -> Emergent universal gateway via the INTERNAL 'emergentintegrations'
#                  package (commented out of requirements.txt; NOT available
#                  off-platform). Do NOT use off-platform — it fails soft to no
#                  completion. Use openai/openrouter instead.
LLM_PROVIDER=openai
OPENAI_API_KEY=                                  # used when LLM_PROVIDER=openai
ANTHROPIC_API_KEY=                               # used when LLM_PROVIDER=anthropic
EMERGENT_LLM_KEY=                                # used when LLM_PROVIDER=emergent (on-platform only)
OPENROUTER_API_KEY=                              # used when LLM_PROVIDER=openrouter (sk-or-v1-…)
OPENROUTER_MODEL=openai/gpt-4o-mini              # used when LLM_PROVIDER=openrouter (default)
SUMMARY_MODEL=                                   # summarizer model id (falls back to OPENAI_MODEL)
OPENAI_MODEL=gpt-4o-mini                         # fallback model id (must be a REAL model)
VERIFIER_MODEL=                                  # citation-verifier model id (falls back to summary model)
LLM_TIMEOUT_SECONDS=60                           # (default: 60)
MESH_RESOLVER_CONFIDENCE_THRESHOLD=0.85          # (default: 0.85)
CLINICAL_CONTEXT_RESOLVER_MODEL=                 # optional model override for the clinical context resolver (empty -> summary model)


# -----------------------------------------------------------------------------
# External medical / scholarly APIs (polite-pool emails + keys, all optional)
# -----------------------------------------------------------------------------
# PubMed / NCBI E-utilities. A key raises the rate limit 3 -> 10 req/s.
NCBI_API_KEY=                                    # primary
PUBMED_API_KEY=                                  # alias (also honored)
NCBI_EMAIL=                                      # contact email (polite pool)
NCBI_TOOL=ClinEvidenceSearch                     # tool identifier
NCBI_TIMEOUT_S=                                  # (default: module constant)
PUBMED_MAX_RESULTS_PER_QUERY=50                  # (default: 50)
PUBMED_REQUESTS_PER_SECOND_NO_KEY=3              # (default: 3)
PUBMED_REQUESTS_PER_SECOND_WITH_KEY=10           # (default: 10)
PUBMED_MAX_CONCURRENT_QUERIES=5                  # B5: per-query fan-out cap (rate-limiter still spaces requests)

# OpenAlex (SET OPENALEX_MAILTO — that is the one the connector reads).
OPENALEX_MAILTO=                                 # polite-pool email ACTUALLY used by connectors
OPENALEX_EMAIL=                                  # declared in Settings only (not read by connector)
OPENALEX_API_KEY=                                # optional premium key
OPENALEX_MAX_ENRICHMENTS_PER_SEARCH=50           # (default: 50)
OPENALEX_MAX_CONCURRENT_ENRICHMENTS=5            # B5: concurrent enrichment fan-out cap (default: 5)
OPENALEX_TIMEOUT_S=                              # (default: module constant)

# NIH iCite (citation-influence). Falls back to OPENALEX_MAILTO if unset.
ICITE_MAILTO=
ICITE_CACHE_TTL_DAYS=30                          # (default: 30)
ICITE_TIMEOUT_S=                                 # (default: module constant)
ICITE_BATCH_SIZE=                                # (default: module constant)

# Europe PMC.
EUROPE_PMC_API_KEY=                              # declared only (connector does not currently read it)
EUROPEPMC_PAGE_SIZE=25                           # (default: 25)
EUROPEPMC_MAX_CONCURRENT_QUERIES=5              # B5: per-query fan-out cap (default: 5)
EUROPEPMC_TIMEOUT_S=                             # (default: module constant)

# Crossref (SET BOTH names to the same address — different code paths read each).
CROSSREF_MAILTO=                                 # access broker / r1c
CROSSREF_EMAIL=                                  # known_article_lookup
CROSSREF_ENABLED=                                # unset -> enabled when CROSSREF_MAILTO present

# Unpaywall (license-aware OA lookup). No API key needed — Unpaywall uses the
# admin email as the identifier (100k calls/day). Set this to enable it.
UNPAYWALL_EMAIL=Info@scienthesis.ai              # presence enables OA lookup in the access broker
UNPAYWALL_ENABLED=                               # unset -> enabled when UNPAYWALL_EMAIL present

# Semantic Scholar (full-text access broker).
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_ENABLED=                        # (default: enabled unless "false")
SS_MAX_LOOKUPS_PER_SEARCH=50                     # (default: 50)

# Shared timeout for the full-text access broker.
ACCESS_BROKER_TIMEOUT_S=                         # (default: module constant)
ACCESS_BROKER_MAX_CONCURRENCY=8                  # perf: concurrent per-article access-broker lookups (default: 8)


# -----------------------------------------------------------------------------
# Open-access full-text fetcher + PDF uploads
# -----------------------------------------------------------------------------
OA_FETCHER_ENABLED=true                          # (default: true)
OA_RETRY_MAX_ATTEMPTS=3                           # (default: 3)
OA_RETRY_MIN_INTERVAL_SECONDS=10                  # (default: 10)
OA_FETCH_TIMEOUT_SECONDS=20                       # per-fetch HTTP timeout (default: 20)
OA_CACHE_DAYS=30                                  # article-level OA cache TTL (default: 30)
OA_MAX_FULL_TEXT_FETCHES_PER_SEARCH=10            # bulk OA fetch cap per search (default: 10)
OA_MAX_CONCURRENT_FETCHES=6                        # perf: concurrent OA fetches in the bulk phase (default: 6)
MAX_EXTRACT_CHARS_PER_ARTICLE=8000               # max chars parsed/ingested per article (default: 8000)
# License gate — default ingests ONLY CC0/BY/BY-SA. Flip ON to also ingest the
# restricted CC variants / preprints. GOVERNANCE: keep OFF unless owner-approved.
OA_ALLOW_NONCOMMERCIAL_LICENSES=false            # allow CC BY-NC* ingest (default: false)
OA_ALLOW_NO_DERIVATIVES_LICENSES=false           # allow CC BY-ND ingest (default: false)
OA_ALLOW_PREPRINTS=false                          # allow preprint full-text ingest (default: false)

# B15 — single-paper full-text finder/import (LitPulse "Full text import" button).
# Resolves ONE paper by PMID/DOI/title, runs the access broker + OA fetcher, and
# returns a ready single-article session to summarize ("evidence chat") or save.
# Orchestrates the access-broker (UNPAYWALL_EMAIL/CROSSREF_MAILTO) + OA fetcher
# above; those keep their own gates. Set the lookup email/keys above for best
# resolution + OA coverage.
FULL_TEXT_IMPORT_ENABLED=true                     # (default: true; off -> endpoint 404s)
FULL_TEXT_IMPORT_MIN_CONFIDENCE=medium           # min match conf to import without accept_low_confidence (high|medium|low)

ENABLE_USER_PDF_UPLOADS=true                      # (default: true; disabled only if "false")
MAX_UPLOAD_MB=25                                  # (default: 25)
MAX_PDF_PAGES=100                                 # (default: 100)
PDF_UPLOAD_ALLOW_WITHOUT_AV=true                  # allow uploads when AV scan unavailable (default: true; set FALSE in prod)

# Uploaded-PDF malware scanning.
PDF_MALWARE_SCAN_ENABLED=false                    # (default: false)
PDF_MALWARE_SCAN_MODE=disabled                    # disabled | clamav | external
CLAMAV_HOST=                                      # required if PDF_MALWARE_SCAN_MODE=clamav
CLAMAV_PORT=
EXTERNAL_MALWARE_SCAN_URL=                        # required if PDF_MALWARE_SCAN_MODE=external
EXTERNAL_MALWARE_SCAN_API_KEY=                    # optional auth for the external scanner


# -----------------------------------------------------------------------------
# Background jobs (summary + OA-fetch async jobs)
# -----------------------------------------------------------------------------
MAX_CONCURRENT_SUMMARY_JOBS=2                     # (default: 2)
MAX_CONCURRENT_OA_FETCH_JOBS=3                    # (default: 3)
JOB_STALE_AFTER_MINUTES=15                        # retention sweep marks older running jobs failed (default: 15)


# -----------------------------------------------------------------------------
# Background jobs + summarization caps
# -----------------------------------------------------------------------------
JOB_RUNNER_MODE=in_process                        # (default: in_process)
SUMMARY_JOB_TIMEOUT_SECONDS=120                   # (default: 120)
MAX_SELECTED_ARTICLES_FOR_SUMMARY=10              # (default: 10)
MAX_SUMMARY_REVISIONS=1                           # (default: 1)

# Directory the /api/handoff/* download router serves from. Defaults to the
# Emergent container layout; override for off-platform/local runs.
HANDOFF_MEMORY_DIR=/app/memory


# -----------------------------------------------------------------------------
# Search-pipeline feature flags (ADVANCED)
# -----------------------------------------------------------------------------
# These tune/gate the deterministic clinical search & ranking pipeline. The
# defaults below match production-safe posture (DEPLOYMENT_ENV_CHECKLIST.md).
# Leave them as-is unless you know the specific phase you are toggling.

# --- Source / startup ---
PHASE5D_CLINICAL_QUERIES_REQUIRED=false
DEV_FORCE_ENABLE_PUBMED=false                     # dev/preview only — NEVER true in prod

# --- M3 active semantic-repair (dormant; keep OFF in prod) ---
SEMANTIC_REPAIR_ACTIVE_ENABLED=false
SEMANTIC_REPAIR_ACTIVE_KILL_SWITCH=true
SEMANTIC_REPAIR_ACTIVE_ENV_ALLOWLIST=development,dev,preview,staging
SEMANTIC_REPAIR_ACTIVE_SHAPES_ALLOWLIST=etiology_risk,pathophysiology_mechanism,procedure_complication
SEMANTIC_REPAIR_ACTIVE_MAX_LATENCY_MS=3500
SEMANTIC_REPAIR_PROD_ALLOW_ACTIVE=false           # MUST stay false in prod
SEMANTIC_REPAIR_CONFIDENCE_THRESHOLD=0.7
SEMANTIC_REPAIR_BRANCH_CAP=6
SEMANTIC_RERANKER_ENABLED=true

# --- M4 active full-question interpretation (dormant; keep OFF in prod) ---
M4_ACTIVE_ENABLED=false
M4_ACTIVE_KILL_SWITCH=true
M4_ACTIVE_ENV_ALLOWLIST=development,dev,preview,staging
M4_ACTIVE_MAX_LATENCY_MS=4000
M4_ACTIVE_PROD_ALLOW_ACTIVE=false                 # MUST stay false in prod
M4_FULL_QUESTION_INTERPRETER_MODE=shadow          # disabled | shadow (never active)
M4_CONFIDENCE_THRESHOLD=0.7

# --- M3.1 admin A/B retrieval benchmark (preview/dev only) ---
M3_1_BENCHMARK_ENABLED=false

# --- K2/K3 clinical query mapping + retracted-article cap enforcement ---
CLINICAL_QUESTION_MAP_BRANCH_QUERIES_MODE=shadow
CLINICAL_ARTICLE_CAP_ENFORCEMENT_MODE=disabled    # disabled | shadow | active
CLINICAL_ARTICLE_LANE_LABEL_MODE=shadow
CLINICAL_ARTICLE_CAP_DETECTION_MODE=shadow
DEPLOYMENT_FINGERPRINT_ALLOW_ACTIVE=              # required (with the two below) for active cap enforcement in prod
ALLOW_PRODUCTION_CAP_ACTIVE=
ACTIVE_CAP_REASON_ALLOWLIST=                      # must include "retracted" to allow active cap enforcement

# --- CQM -> legacy question-type reconciliation ---
# The Phase K1 ClinicalQuestionMap already picks the right framework and
# intent for every question (CoCoPop for prevalence, PIRD for diagnostic
# accuracy, PFO for prognosis, ...), but it is a WRITE-ONLY artifact:
# the live query producers only ever see ``picott_payload``, whose
# coarser ``type_of_question`` is what actually selects the PubMed
# publication-type filter and the Clinical Queries family. The two
# disagree often — e.g. a prevalence question is filtered as a Review.
#
# This bridges them using the closed-set derivation helpers in
# ``services/clinical_question_map.py``. Every value it can write is a
# valid TypeOfQuestion member AND a real study_type_router pathway key.
#
#   disabled — no-op (DEFAULT; byte-identical to previous behavior)
#   shadow   — compute + record the diff under
#              session_diagnostics_json.cqm_type_reconciliation,
#              change nothing that reaches retrieval
#   active   — apply the reconciled type/subtype/scope before the
#              query producers run
#
# Roll out as shadow first, review the ``would_change`` diff across a
# week of real sessions, then flip to active. Rollback = set to shadow.
CQM_TYPE_RECONCILIATION_MODE=disabled             # disabled | shadow | active

# --- Scholar-like query expansion ---
SCHOLAR_LIKE_EXPANSION_MODE=shadow                # disabled | shadow | active
SCHOLAR_LIKE_ACTIVE_ALLOWED=false

# --- L1 evidence-lens / population focus ---
L1_PREFERENCE_MODE=soft_boost                     # soft_boost | shadow (default: soft_boost)
L1_PREFERENCE_PROD_SOFT_BOOST_ALLOWED=false       # MUST stay false in prod
L1_PREFERENCE_PROD_UI_VISIBLE=false               # MUST stay false in prod

# --- Cochrane / ImpactRank / R2A rescue / procedure-anchor critic ---
COCHRANE_PROD_BOOST_ALLOWED=false                 # MUST stay false in prod
IMPACTRANK_MAX_BOOST=8
IMPACTRANK_SHADOW_PROD_ENABLED=false
R2A_CONFIDENCE_THRESHOLD=0.6
R2A_MAX_ARTICLES=30
R2A_RESCUE_PROD_ENABLED=false
PROCEDURE_ANCHOR_CRITIC_ENABLED=false
PROCEDURE_ANCHOR_CRITIC_MODE=shadow

# --- Clinical context resolver ---
CLINICAL_CONTEXT_RESOLVER_ENABLED=true
CLINICAL_CONTEXT_RESOLVER_MODE=fallback_active


# =============================================================================
# Test & developer-tooling only — NOT needed to run the server.
# These are consumed by the test suite / one-off scripts, not the app.
# =============================================================================
# Live acceptance tests target a HOSTED backend; leave empty for local runs.
REACT_APP_BACKEND_URL=
# Seed/utility scripts (scripts/k3b_*, scripts/phase6g_*).
K3B_SPOT_AUDIT_ADMIN_EMAIL=
K3B_SPOT_AUDIT_ADMIN_PASSWORD=
PHASE6G_EMAIL=
PHASE6G_PASSWORD=
# ImpactRank live probe override question.
IMPACTRANK_PROSTATE_Q=
# PYTEST_CURRENT_TEST is set automatically by pytest — DO NOT set it manually.


# -----------------------------------------------------------------------------
# Seed accounts (DEV ONLY — gated by SEED_TEST_USERS AND APP_ENV != production)
# -----------------------------------------------------------------------------
# Leave SEED_TEST_USERS=false in production. The password defaults below are the
# in-source dev defaults; change them and never enable seeding in prod.
SEED_TEST_USERS=false
SEED_CLINICIAN_EMAIL=clinician@test.com
SEED_CLINICIAN_PASSWORD=ClinicianTest123!
SEED_ADMIN_EMAIL=admin@test.com
SEED_ADMIN_PASSWORD=AdminTest123!
